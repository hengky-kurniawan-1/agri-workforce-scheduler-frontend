{
  "name": "agri-workforce-scheduler-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate-api": "openapi-ts -i \"${VITE_OPENAPI_URL:-http://localhost:8000/openapi.json}\" -o src/api/generated -c legacy/axios",
    "generate-api:prod": "openapi-ts -i \"$VITE_OPENAPI_URL_PROD\" -o src/api/generated -c legacy/axios",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.9",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.4",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.6"
  }
}

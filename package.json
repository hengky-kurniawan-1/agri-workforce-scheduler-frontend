{
	"name": "agri-workforce-scheduler-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"generate-api": "openapi-ts -i \"${VITE_OPENAPI_URL:-http://localhost:8000/openapi.json}\" -o src/api/generated -c legacy/axios",
		"generate-api:prod": "openapi-ts -i \"$VITE_OPENAPI_URL_PROD\" -o src/api/generated -c legacy/axios",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.100.10",
		"axios": "^1.7.9",
		"leaflet": "^1.9.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-leaflet": "^5.0.0",
		"react-router-dom": "^7.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@hey-api/openapi-ts": "^0.64.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/leaflet": "^1.9.15",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"jsdom": "^26.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "~5.7.2",
		"vite": "^6.0.6",
		"vitest": "^3.2.4"
	}
}
